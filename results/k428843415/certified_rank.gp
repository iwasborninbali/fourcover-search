default(nbthreads,1);default(realprecision,80);setrand(20261110);
print("VERSION=",version());
k=428843415;E=ellinit([0,0,0,0,k]);T=ellinit([0,0,0,0,-27*k]);
Q=[-21749823817314505417329398578203428726044389786520594015230853682787114924753276288107768790071/35589106081171735697954614495653836664456516348375009203368133815059732677049884911719472225,-3006983147937359986718680977260908084857042951090561334004195430921637930842654352957809370917734940721827109177778158814798527002308734122092/212312527003382662900836631130652382841261077438584845825565459225013474360190212744967783408671947123118390643672707622161170983175995375];R=[,-];
print("ON_E=",ellisoncurve(E,Q),";ON_T=",ellisoncurve(T,R));
print("TORSION_E=",elltors(E),";TORSION_T=",elltors(T));
print("REDUCTION_E=",ellglobalred(E));print("REDUCTION_T=",ellglobalred(T));
forprime(p=2,13,print("LOCAL_E_",p,"=",elllocalred(E,p)));
print("HEIGHT_Q=",ellheight(E,Q));print("HEIGHT_R=",ellheight(T,R));
print("DOUBLE_HEIGHT_RATIO=",ellheight(E,ellmul(E,Q,2))/ellheight(E,Q));
rk=ellrankinit(E);
for(i=1,#rk[3],print("FIELD=",rk[3][i].pol,";DISC=",rk[3][i].disc,";CLASS=",rk[3][i].clgp,";CERTIFY=",bnfcertify(rk[3][i])));
print("RANK_CERTIFIED=",ellrank(rk,0));
print("RANK_WITH_Q=",ellrank(rk,0,[Q]));
print("DONE");
