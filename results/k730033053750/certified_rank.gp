default(nbthreads,1); default(realprecision,70);
print("PARI_VERSION=",version());
E=ellinit([0,0,0,0,730033053750]);
Q=[-127864540025905752836434190966519096512662851319608332803792635443060325/2732848049858431036813881997543283958563840470801202716717782207848409,-122065928537596706107228249110895040861755243563538764427408281909699946209705677476565196173561467921763824675/142864138774358023251040652571655140848277152021135716683738993203046179270987130401371701590136836137827];
print("ON_CURVE=",ellisoncurve(E,Q)); print("TORSION=",elltors(E));
print("GLOBAL_RED=",ellglobalred(E));print("HEIGHT=",ellheight(E,Q));print("DOUBLE_HEIGHT_RATIO=",ellheight(E,ellmul(E,Q,2))/ellheight(E,Q));
rk=ellrankinit(E);
for(i=1,#rk[3],print("FIELD=",rk[3][i].pol,";DISC=",rk[3][i].disc,";CLASS=",rk[3][i].clgp,";CERTIFY=",bnfcertify(rk[3][i])));
